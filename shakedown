#!/usr/bin/env bash
# Release entry: run the committed play with the shakespearelang CLI.
#
# Prefers `shakespeare` on PATH (no project toolchain required). Falls back to
# `uv run` so a clone with only uv can still resolve shakespearelang from
# pyproject.toml. Override the play with SHAKEDOWN_SPL (used by ./shakedown-debug).
#
# The shakespeare CLI can exit 0 on SPL parse/runtime failures while still
# printing "SPL … error:" on stderr; treat that as failure.
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
SPL="${SHAKEDOWN_SPL:-$DIR/shakedown.spl}"

err="$(mktemp)"
trap 'rm -f "$err"' EXIT

set +e
if command -v shakespeare >/dev/null 2>&1; then
  shakespeare run "$SPL" 2>"$err"
else
  uv run --directory "$DIR" shakespeare run "$SPL" 2>"$err"
fi
rc=$?
set -e

cat "$err" >&2

if [[ "$rc" -ne 0 ]]; then
  exit "$rc"
fi
if grep -qE '^SPL (runtime|parse) error:' "$err"; then
  exit 1
fi
exit 0
